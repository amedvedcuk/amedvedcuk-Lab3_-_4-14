<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MauiApp3.ViewModels"
             x:Class="MauiApp3.Views.SettingsPage"
             x:DataType="viewmodels:SettingsViewModel"
             Title="Налаштування">

    <VerticalStackLayout Padding="20" Spacing="16">

        <Label Text="{Binding CurrentThemeLabel}"
               FontSize="18"
               FontAttributes="Bold" />

        <HorizontalStackLayout Spacing="12">
            <Label Text="Темна тема"
                   VerticalOptions="Center" />
            <Switch IsToggled="{Binding IsDarkTheme, Mode=TwoWay}" />
        </HorizontalStackLayout>

        <Button Text="Світла тема"
                Command="{Binding SetLightThemeCommand}" />

        <Button Text="Темна тема"
                Command="{Binding SetDarkThemeCommand}" />

    </VerticalStackLayout>

</ContentPage>