<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MauiApp3.ViewModels"
             x:Class="MauiApp3.Views.StudentDetailPage"
             x:DataType="viewmodels:StudentDetailViewModel"
             Title="Деталі студента">

    <VerticalStackLayout Padding="20" Spacing="14">

        <Label Text="{Binding FullName}"
               FontSize="20"
               FontAttributes="Bold" />

        <Label Text="{Binding Group, StringFormat='Група: {0}'}"
               FontSize="16" />

        <Label Text="{Binding AverageScore, StringFormat='Поточний середній бал: {0:F2}'}"
               FontSize="16" />

        <Label Text="Редагувати середній бал:"
               Margin="0,8,0,0" />

        <Entry Text="{Binding AverageScore, Mode=TwoWay}"
               Keyboard="Numeric" />

        <Stepper Minimum="0"
                 Maximum="5"
                 Increment="0.1"
                 Value="{Binding AverageScore, Mode=TwoWay}" />

        <Button Text="Зберегти"
                Command="{Binding SaveCommand}" />

        <Button Text="Назад"
                Command="{Binding GoBackCommand}" />

    </VerticalStackLayout>

</ContentPage>